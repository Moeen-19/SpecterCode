{
  "name": "mirror-canvas",
  "displayName": "MirrorCanvas: The Living Interface",
  "description": "An intelligent, emotionally reactive code editor extension that transforms your workspace into a living mirror of your emotions and creative flow",
  "version": "0.1.0",
  "publisher": "kiro-dev",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Themes",
    "Visualization"
  ],
  "keywords": [
    "emotion",
    "ai",
    "theme",
    "animation",
    "productivity",
    "mood",
    "ambient"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mirrorCanvas.activate",
    "onCommand:mirrorCanvas.switchTheme",
    "onCommand:mirrorCanvas.showSettings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mirrorCanvas.activate",
        "title": "Activate MirrorCanvas",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.deactivate",
        "title": "Deactivate MirrorCanvas",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.switchTheme",
        "title": "Switch Theme",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.showSettings",
        "title": "Open Settings",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.showEmotionalJourney",
        "title": "Show Emotional Journey",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.switchThemeQuick",
        "title": "Quick Theme Switch",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "MirrorCanvas"
      },
      {
        "command": "mirrorCanvas.showPerformance",
        "title": "Show Performance Report",
        "category": "MirrorCanvas"
      }
    ],
    "keybindings": [
      {
        "command": "mirrorCanvas.switchTheme",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorFocus"
      },
      {
        "command": "mirrorCanvas.switchThemeQuick",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorFocus"
      },
      {
        "command": "mirrorCanvas.showSettings",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "editorFocus"
      }
    ],
    "configuration": {
      "title": "MirrorCanvas",
      "properties": {
        "mirrorCanvas.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable MirrorCanvas emotional interface"
        },
        "mirrorCanvas.theme": {
          "type": "string",
          "default": "halloween",
          "enum": ["halloween", "rainy-forest", "cafe", "cave", "neon-city"],
          "description": "Active theme for MirrorCanvas"
        },
        "mirrorCanvas.emotionSensitivity": {
          "type": "number",
          "default": 0.7,
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "Sensitivity of emotion detection (0.1 = low, 1.0 = high)"
        },
        "mirrorCanvas.animationIntensity": {
          "type": "number",
          "default": 0.8,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Intensity of visual animations (0.0 = disabled, 1.0 = maximum)"
        },
        "mirrorCanvas.audioEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable ambient audio and sound effects"
        },
        "mirrorCanvas.audioVolume": {
          "type": "number",
          "default": 0.3,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Volume level for audio effects"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.1",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "@huggingface/inference": "^2.6.4",
    "better-sqlite3": "^8.7.0"
  }
}